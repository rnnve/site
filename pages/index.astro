---
import MainLayout from '@/layouts/MainLayout.astro';
import { getInitialLiveData } from '@/lib/initial-live';
import HomeContent from '@/components/HomeContent.tsx';
import type { LiveLastFmView } from '@/lib/integrations';

const HOME_VIEWS: readonly LiveLastFmView[] = ['recent'];

let initialData: Awaited<ReturnType<typeof getInitialLiveData>>;
try {
  initialData = await getInitialLiveData(HOME_VIEWS);
} catch {
  initialData = {
    discord: null,
    spotify: null,
    spotifyStopped: false,
    lastfm: {},
    lastfmError: {},
  };
}
---

<MainLayout
  title="Rinne"
  description="Rinne — live Spotify, Discord and Last.fm status."
  lang="en"
>
            </div>
            <div class="min-w-0 rounded-2xl border border-outline-variant bg-surface-container/80 p-4 sm:p-5">
              <SpotifyNowPlaying client:load />
            </div>
          </div>
        </section>
        <SiteFooter client:visible />
      </div>
    </main>
  </LiveProvider>
</MainLayout>