---
import MainLayout from '@/layouts/MainLayout.astro';
import { getInitialLiveData } from '@/lib/initial-live';
import MusicIsland from '@/components/MusicIsland.tsx';
import type { LiveLastFmView } from '@/lib/integrations';

const ALL_VIEWS: readonly LiveLastFmView[] = ['recent', 'toptracks', 'topartists', 'info'];

let initialData: Awaited<ReturnType<typeof getInitialLiveData>>;
try {
  initialData = await getInitialLiveData(ALL_VIEWS);
} catch {
  initialData = {
    discord: null,
    spotify: null,
    spotifyStopped: false,
    lastfm: {},
    lastfmError: {},
  };
}
---

<MainLayout
  title="Music · Rinne"
  description="Last.fm recent tracks, top tracks, artists and stats."
  lang="en"
>
  </LiveProvider>
</MainLayout>