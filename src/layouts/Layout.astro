---
import '../styles/global.css';

const preconnects = [
	'https://spotify.mapleji.xyz',
	'https://api.mapleji.xyz',
	'https://ws.audioscrobbler.com',
	'https://i.scdn.co',
	'https://cdn.discordapp.com',
	'https://media.discordapp.net',
];
---

<!doctype html>
<html lang="en" class="mocha">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="description" content="Rinne — live Spotify, Discord and Last.fm status." />
		<meta property="og:title" content="Rinne" />
		<meta property="og:description" content="Live Spotify, Discord and Last.fm status." />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Rinne</title>
		{preconnects.map((href) => <link rel="preconnect" href={href} crossorigin="anonymous" />)}
		<script defer src="https://portus.sh/p.js" data-site="prt_jjudtdtrznlr4buly6yo"></script>
		<script type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "19e054ca2aae4e1d80634a3fb040be6a"}'></script>
	</head>
	<body class="bg-ctp-base">
		<nav class="sticky top-0 z-50 pl-[max(0.75rem,env(safe-area-inset-left))] pr-[max(0.75rem,env(safe-area-inset-right))] py-2.5 sm:pl-[max(1.5rem,env(safe-area-inset-left))] sm:pr-[max(1.5rem,env(safe-area-inset-right))] sm:py-3">
			<div class="mx-auto flex w-full max-w-3xl items-center justify-between rounded-2xl border border-ctp-surface1 bg-ctp-surface0/80 px-4 py-2.5 shadow-lg shadow-ctp-mantle/40 backdrop-blur-md sm:px-5 sm:py-3">
				<a href="/" class="text-sm font-bold text-ctp-text">Rinne</a>
				<div class="flex items-center gap-3">
					<a
						href="https://github.com/rnnve"
						target="_blank"
						rel="noreferrer"
						class="text-xs text-ctp-subtext0 transition hover:text-ctp-text"
					>
						GitHub
					</a>
					<a
						href="https://haunt.gg/rnn"
						target="_blank"
						rel="noreferrer"
						class="text-xs text-ctp-subtext0 transition hover:text-ctp-text"
					>
						Links
					</a>
				</div>
			</div>
		</nav>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		background-color: var(--catppuccin-color-base);
	}
</style>
