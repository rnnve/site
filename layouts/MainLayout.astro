---
import BaseLayout from './BaseLayout.astro';
import NavIsland from '@/components/NavIsland.tsx';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  lang?: 'en' | 'th';
  canonical?: string;
  ogImage?: string;
}

const { title, description, lang = 'en', canonical, ogImage } = Astro.props;
---

<BaseLayout title={title} description={description} lang={lang} canonical={canonical} ogImage={ogImage}>
    </div>
  </I18nProvider>
</BaseLayout>